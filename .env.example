DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.up.railway.app,.onrender.com,.vercel.app

# Base de datos (Local o Producción)
# En Railway/Render, DATABASE_URL es inyectada automáticamente:
# DATABASE_URL=postgresql://user:password@host:port/dbname
DB_ENGINE=django.db.backends.postgresql
DB_NAME=programaciondb
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Cloudinary (Almacenamiento multimedia en producción)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# RAWG API Key (Opcional, para catálogo y buscador de juegos)
# RAWG_API_KEY=tu-api-key-de-rawg

# CORS & CSRF (Opcional, para agregar dominios extras de Frontend)
# CORS_ALLOWED_ORIGINS=https://mi-foro.vercel.app
# CSRF_TRUSTED_ORIGINS=https://mi-foro.vercel.app

# TP4 API test credentials (local only)
TP4_BASE_URL=http://localhost:8000
TP4_ADMIN_USERNAME=admin
TP4_ADMIN_PASSWORD=change-me
TP4_MOD_USERNAME=mod
TP4_MOD_PASSWORD=change-me
TP4_USER_USERNAME=testuser_tp4
TP4_USER_EMAIL=testuser_tp4@example.com
TP4_USER_PASSWORD=change-me
TP4_OTHER_USERNAME=otheruser_tp4
TP4_OTHER_EMAIL=otheruser_tp4@example.com
TP4_FLOW_PASSWORD=change-me
